{
    "name": "u",
    "displayName": "μ embedded language",
    "description": "bytecode virtual machine (embedded language script engine)",
    "version": "0.0.1",
    "publisher": "dponyatov",
    "icon": "logo.png",
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "license": "MIT",
    "keywords": ["bytecode", "embedded", "scripting", "FORTH"],
    "contributes": {
        "languages": [
            {
                "id": "u",
                "aliases": ["u"],
                "extensions": [".ini",".u"],
                "configuration": "./u.language.json"
            }
        ],
        "grammars": [
            {
                "language": "u",
                "scopeName": "source.u",
                "path": "./u.tmLanguage.json"
            }
        ]
    }
}
