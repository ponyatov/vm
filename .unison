# ln -fs ~/vm/.unison ~/.unison/vm.prf
# unison vm

root = ./doc/vm
root = /home/dponyatov/metadoc/vm

prefer = newer
watch = true
batch = true

ignore = Name {.git}
ignore = Name {*~,*.log,*.sw?}
ignore = Name {bin,tmp,ref,_build,target}
ignore = Name {doc/html}
ignore = Name {node_modules,.cache}
ignore = Name {*.pyc,__pycache__}
